<?xml version="1.0" encoding="UTF-8"?>
<!--
  Peler Edition test fixture for HtmlExportDifferentialTest.

  P = NAND(XOR(A,B), XOR(A,B)) = XNOR(A,B)
  Q = NOT(NOR(C,C))            = C

  Port coordinates are not guessable: gates whose outline carries a curve or an inversion bubble
  (XOR, NOR, NAND) sit 10 units wider on the input side than AND does, so their inputs are at
  x=220 and x=360 rather than 230 and 370. Read them off a component before editing this file.
  Wires that miss by 10 leave the circuit silently unconnected, which is how this fixture was
  wrong the first time.

  Note also that a doubled hyphen anywhere in this comment makes the whole file unparseable.
-->
<project version="1.0">
 <lib name="0" desc="#Wiring" />
 <lib name="1" desc="#Gates" />
 <lib name="8" desc="#Base" />
 <main name="main" />
 <options>
  <a name="showgrid" val="true" />
  <a name="simulate" val="true" />
 </options>
 <circuit name="main">
  <a name="circuit" val="main" />

  <comp lib="0" loc="(100,100)" name="Pin"><a name="label" val="A" /></comp>
  <comp lib="0" loc="(100,160)" name="Pin"><a name="label" val="B" /></comp>
  <comp lib="0" loc="(100,220)" name="Pin"><a name="label" val="C" /></comp>

  <comp lib="1" loc="(260,130)" name="XOR Gate"><a name="size" val="30" /></comp>
  <comp lib="1" loc="(260,220)" name="NOR Gate"><a name="size" val="30" /></comp>
  <comp lib="1" loc="(400,130)" name="NAND Gate"><a name="size" val="30" /></comp>
  <comp lib="1" loc="(400,220)" name="NOT Gate" />

  <comp lib="0" loc="(500,130)" name="Pin">
   <a name="facing" val="west" /><a name="output" val="true" /><a name="label" val="P" />
  </comp>
  <comp lib="0" loc="(500,220)" name="Pin">
   <a name="facing" val="west" /><a name="output" val="true" /><a name="label" val="Q" />
  </comp>

  <wire from="(100,100)" to="(220,100)" />
  <wire from="(220,100)" to="(220,120)" />
  <wire from="(100,160)" to="(220,160)" />
  <wire from="(220,140)" to="(220,160)" />

  <wire from="(100,220)" to="(220,220)" />
  <wire from="(220,210)" to="(220,220)" />
  <wire from="(220,220)" to="(220,230)" />

  <wire from="(260,130)" to="(300,130)" />
  <wire from="(300,120)" to="(300,130)" />
  <wire from="(300,130)" to="(300,140)" />
  <wire from="(300,120)" to="(360,120)" />
  <wire from="(300,140)" to="(360,140)" />

  <wire from="(260,220)" to="(370,220)" />

  <wire from="(400,130)" to="(500,130)" />
  <wire from="(400,220)" to="(500,220)" />
 </circuit>
</project>
